RTSP_PROXY_NODE_HELPER_EXTERNAL_PORT_START=10000
RTSP_PROXY_NODE_HELPER_EXTERNAL_PORT_END=10999
RTSP_PROXY_NODE_HELPER_API_PORT_START=20000
RTSP_PROXY_NODE_HELPER_API_PORT_END=20099
RTSP_PROXY_NODE_HELPER_METRICS_PORT_START=20100
RTSP_PROXY_NODE_HELPER_METRICS_PORT_END=20199
RTSP_PROXY_NODE_HELPER_AUTH_CALLBACK_PORT=8010
RTSP_PROXY_NODE_HELPER_AUTH_CALLBACK_PEPPER_FILE=/etc/rtsp-proxy/control-plane/access-peppers.json
RTSP_PROXY_NODE_HELPER_RELEASE_ID=0.2.0
RTSP_PROXY_NODE_HELPER_MEDIAMTX_BINARY=/opt/rtsp-proxy/releases/0.2.0/bin/mediamtx
# Replace with the architecture-specific binary digest from the verified release.
RTSP_PROXY_NODE_HELPER_MEDIAMTX_BINARY_SHA256=replace-with-64-lowercase-hex
# No Phase-E rollback target exists yet: 0.1.0 predates authenticated callback
# management. Populate PREVIOUS_* only with a future callback-compatible entry.
RTSP_PROXY_NODE_HELPER_REQUEST_TIMEOUT_SECONDS=5
RTSP_PROXY_NODE_HELPER_OPERATION_TIMEOUT_SECONDS=55
RTSP_PROXY_NODE_HELPER_CLEANUP_RESERVE_SECONDS=25
RTSP_PROXY_NODE_HELPER_MAX_WORKERS=16
