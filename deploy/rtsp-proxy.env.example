RTSP_PROXY_HTTP_HOST=127.0.0.1
RTSP_PROXY_HTTP_PORT=8000
RTSP_PROXY_AUTH_HOST=127.0.0.1
RTSP_PROXY_AUTH_PORT=8010
RTSP_PROXY_AUTH_DATABASE_TIMEOUT_SECONDS=1
# Root-owned 0640 root:rtsp-proxy JSON; never put pepper bytes in this env file.
RTSP_PROXY_ACCESS_PEPPER_FILE=/etc/rtsp-proxy/control-plane/access-peppers.json
RTSP_PROXY_MAX_NODES=50
RTSP_PROXY_NODE_PORT_RANGE_START=10000
RTSP_PROXY_NODE_PORT_RANGE_END=10999
RTSP_PROXY_NODE_PORT_RESERVED=
RTSP_PROXY_NODE_API_PORT_RANGE_START=20000
RTSP_PROXY_NODE_API_PORT_RANGE_END=20099
RTSP_PROXY_NODE_METRICS_PORT_RANGE_START=20100
RTSP_PROXY_NODE_METRICS_PORT_RANGE_END=20199
RTSP_PROXY_NODE_MANAGEMENT_FRESHNESS_SECONDS=30
RTSP_PROXY_NODE_LIFECYCLE_LOCK_POOL_SIZE=4
RTSP_PROXY_NODE_LIFECYCLE_LOCK_TIMEOUT_SECONDS=5
RTSP_PROXY_NODE_RUNTIME_SOCKET=/run/rtsp-proxy-node-runtime/control.sock
RTSP_PROXY_NODE_RUNTIME_TIMEOUT_SECONDS=60
RTSP_PROXY_RECONCILE_INTERVAL_SECONDS=1
# Worker-only SMTP incident notifications. STARTTLS is mandatory; the password
# file must be root-owned regular 0400/0600 with one link.
# RTSP_PROXY_SMTP_HOST=smtp.example.net
# RTSP_PROXY_SMTP_PORT=587
# RTSP_PROXY_SMTP_USERNAME=rtsp-proxy
# RTSP_PROXY_SMTP_PASSWORD_FILE=/etc/rtsp-proxy/control-plane/smtp-password
# RTSP_PROXY_SMTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# RTSP_PROXY_SMTP_FROM_ADDRESS=rtsp-proxy@example.net
# RTSP_PROXY_SMTP_TO_ADDRESS=operator@example.net
# RTSP_PROXY_SMTP_STARTTLS=true
# RTSP_PROXY_SMTP_TIMEOUT_SECONDS=10
# Generate at least 32 random bytes and encode without whitespace. Web-only.
RTSP_PROXY_CONFIRMATION_SECRET=replace-with-high-entropy-confirmation-secret
RTSP_PROXY_NODE_RELEASE_ID=0.2.1
# Must equal the helper's architecture-specific verified MediaMTX digest.
RTSP_PROXY_NODE_MEDIAMTX_BINARY_SHA256=replace-with-64-lowercase-hex
RTSP_PROXY_DATABASE_URL=postgresql+psycopg://rtsp_proxy@127.0.0.1:5432/rtsp_proxy
