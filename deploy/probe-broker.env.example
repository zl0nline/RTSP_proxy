# Exact root-owned executable admitted by the packaged architecture catalog.
# Kernel/tool package upgrades require a reviewed catalog update before restart.
RTSP_PROXY_PROBE_BPFTOOL=/usr/lib/linux-tools-6.8.0-138/bpftool
# Canonical, sorted, non-overlapping camera networks; empty is not accepted.
RTSP_PROXY_PROBE_ALLOWED_CIDRS=10.20.0.0/16,2001:db8:20::/64
