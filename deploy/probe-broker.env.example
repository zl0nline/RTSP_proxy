# Exact immutable release executable admitted by the packaged architecture catalog.
# It is shipped with each native release so distro package upgrades cannot replace it.
RTSP_PROXY_PROBE_BPFTOOL=/opt/rtsp-proxy/current/libexec/rtsp-proxy-probe/bpftool
# Canonical, sorted, non-overlapping camera networks; empty is not accepted.
RTSP_PROXY_PROBE_ALLOWED_CIDRS=10.20.0.0/16,2001:db8:20::/64
