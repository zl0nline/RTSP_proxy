[Unit]
Description=RTSP Proxy owned nftables boundary
DefaultDependencies=no
After=local-fs.target network-pre.target
Before=network.target rtsp-proxy-node-runtime.service rtsp-proxy-media@.service

[Service]
Type=oneshot
ExecStart=/opt/rtsp-proxy/current/.venv/bin/rtsp-proxy-nft-reconcile
RemainAfterExit=yes
RuntimeDirectory=rtsp-proxy-nftables
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK

[Install]
WantedBy=multi-user.target
