[Unit]
Description=RTSP Proxy web control plane
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rtsp-proxy
Group=rtsp-proxy
Environment=RTSP_PROXY_ROLE=web
EnvironmentFile=/etc/rtsp-proxy/control-plane/rtsp-proxy.env
LoadCredential=management-tls.pem:/etc/rtsp-proxy/control-plane/management-tls-current/management-tls.pem
WorkingDirectory=/opt/rtsp-proxy/current
ExecStart=/opt/rtsp-proxy/current/.venv/bin/rtsp-proxy-web --management-tls-certificate-file=%d/management-tls.pem --management-tls-private-key-file=%d/management-tls.pem
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077

RuntimeDirectory=rtsp-proxy
StateDirectory=rtsp-proxy
LogsDirectory=rtsp-proxy
RuntimeDirectoryMode=0751
StateDirectoryMode=0751
LogsDirectoryMode=0751
ReadWritePaths=/run/rtsp-proxy /var/lib/rtsp-proxy /var/log/rtsp-proxy
ReadOnlyPaths=/etc/rtsp-proxy/control-plane/access-peppers.json -/etc/rtsp-proxy/control-plane/camera-source-keys.json

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
