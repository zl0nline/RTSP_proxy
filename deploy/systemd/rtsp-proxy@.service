[Unit]
Description=RTSP Proxy %i role
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecCondition=/usr/bin/test %i = reconciler
User=rtsp-proxy
Group=rtsp-proxy
Environment=RTSP_PROXY_ROLE=%i
EnvironmentFile=/etc/rtsp-proxy/control-plane/rtsp-proxy-%i.env
WorkingDirectory=/opt/rtsp-proxy/current
ExecStart=/opt/rtsp-proxy/current/.venv/bin/rtsp-proxy-role --expected-role=%i
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077

RuntimeDirectory=rtsp-proxy-%i
StateDirectory=rtsp-proxy
LogsDirectory=rtsp-proxy
RuntimeDirectoryMode=0750
StateDirectoryMode=0750
LogsDirectoryMode=0750
ReadWritePaths=/run/rtsp-proxy-%i /var/lib/rtsp-proxy /var/log/rtsp-proxy

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
