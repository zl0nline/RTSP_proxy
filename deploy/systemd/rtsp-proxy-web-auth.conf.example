[Service]
Environment="RTSP_PROXY_OIDC_JWKS_FILE=%d/oidc-jwks.json" "RTSP_PROXY_OIDC_CLIENT_SECRET_FILE=%d/oidc-client-secret" "RTSP_PROXY_OIDC_DERIVATION_KEY_FILE=%d/oidc-derivation-key" "RTSP_PROXY_OIDC_GROUP_ROLES_FILE=%d/oidc-group-roles.json" "RTSP_PROXY_BREAK_GLASS_ENCRYPTION_KEY_FILE=%d/break-glass-key"
LoadCredential=oidc-jwks.json:/etc/rtsp-proxy/control-plane/oidc-jwks.json oidc-client-secret:/etc/rtsp-proxy/control-plane/oidc-client-secret oidc-derivation-key:/etc/rtsp-proxy/control-plane/oidc-derivation-key oidc-group-roles.json:/etc/rtsp-proxy/control-plane/oidc-group-roles.json break-glass-key:/etc/rtsp-proxy/control-plane/break-glass-key
