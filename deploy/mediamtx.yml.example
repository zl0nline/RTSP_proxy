# MediaMTX v1.20.0 Phase 0 baseline. Paths and external grants are intentionally
# absent until the adapter/auth contract is proven and configured.

logLevel: info
logDestinations: [stdout]
logStructured: true

authMethod: internal
authInternalUsers:
  - user: any
    pass:
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: api
      - action: metrics

api: true
apiAddress: 127.0.0.1:9997
apiEncryption: false
apiAllowOrigins: []
apiTrustedProxies: []

metrics: true
metricsAddress: 127.0.0.1:9998
metricsEncryption: false
metricsAllowOrigins: []
metricsTrustedProxies: []

pprof: false
playback: false

# External clients see an ordinary RTSP server. There is no RTSPS listener and
# no proxy-specific scheme or handshake.
rtsp: true
rtspTransports: [tcp]
rtspEncryption: "no"
rtspAddress: :9999
rtspAuthMethods: [basic]
rtspTrustedProxies: []

rtmp: false
hls: false
webrtc: false
srt: false
moq: false

paths: {}
