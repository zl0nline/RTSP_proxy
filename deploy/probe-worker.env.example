# Unprivileged periodic source-probe worker. Copy to
# /etc/rtsp-proxy/control-plane/rtsp-proxy-probe.env, mode 0640 root:rtsp-proxy-access.
RTSP_PROXY_HTTP_HOST=127.0.0.1
RTSP_PROXY_HTTP_PORT=8103
RTSP_PROXY_DATABASE_URL=postgresql+psycopg://rtsp_proxy@127.0.0.1:5432/rtsp_proxy
RTSP_PROXY_CAMERA_SOURCE_KEYS_FILE=/etc/rtsp-proxy/control-plane/camera-source-keys.json
RTSP_PROXY_PROBE_SOURCE_SITE_KEY=local
RTSP_PROXY_PROBE_SOURCE_CIDRS=
RTSP_PROXY_PROBE_BROKER_SOCKET=/run/rtsp-proxy-probe-broker/control.sock
RTSP_PROXY_NODE_RUNTIME_SOCKET=/run/rtsp-proxy-node-runtime/control.sock
RTSP_PROXY_NODE_RUNTIME_TIMEOUT_SECONDS=10
RTSP_PROXY_NODE_RELEASE_ID=0.2.1
RTSP_PROXY_NODE_MEDIAMTX_BINARY_SHA256=replace-with-64-lowercase-hex
RTSP_PROXY_PROBE_INTERVAL_SECONDS=5
RTSP_PROXY_PROBE_BATCH_LIMIT=256
RTSP_PROXY_PROBE_EXECUTION_WORKERS=4
