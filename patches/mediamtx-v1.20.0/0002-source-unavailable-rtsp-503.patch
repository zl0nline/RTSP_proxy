+func TestServerSourceUnavailable(t *testing.T) {
+	pathManager := &test.PathManager{
+		DescribeImpl: func(req defs.PathDescribeReq) (*defs.PathDescribeRes, error) {
+			return nil, &defs.PathSourceUnavailableError{PathName: req.AccessRequest.Name}
+		},
+	}
+
+	s := &Server{
+		Address:        "127.0.0.1:8557",
+		ReadTimeout:    conf.Duration(10 * time.Second),
+		WriteTimeout:   conf.Duration(10 * time.Second),
+		WriteQueueSize: 512,
+		Transports:     conf.RTSPTransports{gortsplib.ProtocolTCP: {}},
+		PathManager:    pathManager,
+		Parent:         test.NilLogger,
+	}
+	require.NoError(t, s.Initialize())
+	defer s.Close()
+
+	conn, err := net.Dial("tcp", "127.0.0.1:8557")
+	require.NoError(t, err)
+	defer conn.Close()
+
+	_, err = conn.Write([]byte("DESCRIBE rtsp://127.0.0.1:8557/camera RTSP/1.0\r\nCSeq: 1\r\n\r\n"))
+	require.NoError(t, err)
+	var res base.Response
+	require.NoError(t, res.Unmarshal(bufio.NewReader(conn)))
+	require.Equal(t, base.StatusServiceUnavailable, res.StatusCode)
+}
