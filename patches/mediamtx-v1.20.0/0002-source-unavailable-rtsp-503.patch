+// PathSourceUnavailableError is returned when an on-demand source did not
+// become available within its configured startup window.
+type PathSourceUnavailableError struct {
+	PathName string
+}
+
+func (e *PathSourceUnavailableError) Error() string {
+	return "source of path '" + e.PathName + "' is unavailable"
+}
+
 func (e *PathMaxReadersReachedError) Error() string {
 	return "maximum reader count reached on path '" + e.PathName + "'"
 }
