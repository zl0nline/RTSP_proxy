+func TestPathMaxReadersHotReloadKeepsEstablishedReader(t *testing.T) {
+	p, ok := newInstance(t, "api: yes\npaths:\n  all_others:\n    maxReaders: 1\n")
+	require.Equal(t, true, ok)
+	defer p.Close()
+
+	media := test.UniqueMediaH264()
+	source := gortsplib.Client{}
+	err := source.StartRecording(
+		"rtsp://localhost:8554/mystream",
+		&description.Session{Medias: []*description.Media{media}})
+	require.NoError(t, err)
+	defer source.Close()
+
+	u, err := base.ParseURL("rtsp://127.0.0.1:8554/mystream")
+	require.NoError(t, err)
+	reader := gortsplib.Client{Scheme: u.Scheme, Host: u.Host}
+	err = reader.Start()
+	require.NoError(t, err)
+	defer reader.Close()
+	desc, _, err := reader.Describe(u)
+	require.NoError(t, err)
+	err = reader.SetupAll(desc.BaseURL, desc.Medias)
+	require.NoError(t, err)
+	packetRecv := make(chan struct{}, 1)
+	reader.OnPacketRTP(desc.Medias[0], desc.Medias[0].Formats[0], func(_ *rtp.Packet) {
+		select {
+		case packetRecv <- struct{}{}:
+		default:
+		}
+	})
+	_, err = reader.Play(nil)
+	require.NoError(t, err)
+
+	tr := &http.Transport{}
+	defer tr.CloseIdleConnections()
+	httpRequest(t, &http.Client{Transport: tr}, http.MethodPatch,
+		"http://localhost:9997/v3/config/paths/patch/all_others",
+		map[string]any{"maxReaders": -1}, nil)
+
+	err = source.WritePacketRTP(media, &rtp.Packet{
+		Header:  rtp.Header{Version: 2, PayloadType: 96, SequenceNumber: 1, Timestamp: 1, SSRC: 1},
+		Payload: []byte{5},
+	})
+	require.NoError(t, err)
+	select {
+	case <-packetRecv:
+	case <-time.After(5 * time.Second):
+		t.Fatal("established reader stopped receiving after maxReaders hot reload")
+	}
+
+	second := gortsplib.Client{Scheme: u.Scheme, Host: u.Host}
+	err = second.Start()
+	require.NoError(t, err)
+	defer second.Close()
+	desc2, _, err := second.Describe(u)
+	require.NoError(t, err)
+	err = second.SetupAll(desc2.BaseURL, desc2.Medias)
+	require.EqualError(t, err, "bad status code: 453 (Not Enough Bandwidth)")
+	second.Close()
+
+	httpRequest(t, &http.Client{Transport: tr}, http.MethodPatch,
+		"http://localhost:9997/v3/config/paths/patch/all_others",
+		map[string]any{"maxReaders": 1}, nil)
+	lateAfterOpen := gortsplib.Client{Scheme: u.Scheme, Host: u.Host}
+	err = lateAfterOpen.Start()
+	require.NoError(t, err)
+	defer lateAfterOpen.Close()
+	desc2, _, err = lateAfterOpen.Describe(u)
+	require.NoError(t, err)
+	err = lateAfterOpen.SetupAll(desc2.BaseURL, desc2.Medias)
+	require.EqualError(t, err, "bad status code: 453 (Not Enough Bandwidth)")
+
+	reader.Close()
+	third := gortsplib.Client{Scheme: u.Scheme, Host: u.Host}
+	err = third.Start()
+	require.NoError(t, err)
+	defer third.Close()
+	desc3, _, err := third.Describe(u)
+	require.NoError(t, err)
+	err = third.SetupAll(desc3.BaseURL, desc3.Medias)
+	require.NoError(t, err)
+}
+
+func TestPathMaxReadersHotReloadSourceChurnDoesNotDeadlock(t *testing.T) {
+	p, ok := newInstance(t, "api: yes\npaths:\n  all_others:\n    maxReaders: 1\n")
+	require.Equal(t, true, ok)
+	defer p.Close()
+
+	tr := &http.Transport{}
+	defer tr.CloseIdleConnections()
+	hc := &http.Client{Transport: tr, Timeout: 5 * time.Second}
+	for i := range 50 {
+		source := gortsplib.Client{}
+		media := test.UniqueMediaH264()
+		err := source.StartRecording(
+			"rtsp://localhost:8554/mystream",
+			&description.Session{Medias: []*description.Media{media}})
+		require.NoError(t, err)
+
+		closed := make(chan struct{})
+		go func() {
+			source.Close()
+			close(closed)
+		}()
+		httpRequest(t, hc, http.MethodPatch,
+			"http://localhost:9997/v3/config/paths/patch/all_others",
+			map[string]any{"maxReaders": []int{1, -1}[i%2]}, nil)
+		select {
+		case <-closed:
+		case <-time.After(5 * time.Second):
+			t.Fatal("maxReaders reload deadlocked with source ready/offline callback")
+		}
+	}
+}
