+
+func TestServerSessionRecordStateMetricsRace(t *testing.T) {
+	readerStarted := make(chan struct{})
+	readerDone := make(chan struct{})
+	var stopReader atomic.Bool
+
+	s := &Server{
+		Handler: &testServerHandler{
+			onAnnounce: func(_ *ServerHandlerOnAnnounceCtx) (*base.Response, error) {
+				return &base.Response{StatusCode: base.StatusOK}, nil
+			},
+			onSetup: func(_ *ServerHandlerOnSetupCtx) (*base.Response, *ServerStream, error) {
+				return &base.Response{StatusCode: base.StatusOK}, nil, nil
+			},
+			onRecord: func(ctx *ServerHandlerOnRecordCtx) (*base.Response, error) {
+				go func() {
+					ctx.Session.State()
+					close(readerStarted)
+					for !stopReader.Load() {
+						ctx.Session.State()
+					}
+					close(readerDone)
+				}()
+				<-readerStarted
+				return &base.Response{StatusCode: base.StatusOK}, nil
+			},
+		},
+		RTSPAddress: "127.0.0.1:8554",
+	}
+	require.NoError(t, s.Start())
+	defer s.Close()
+
+	proto := ProtocolTCP
+	c := Client{Protocol: &proto}
+	desc := &description.Session{
+		Medias: []*description.Media{{
+			Type: description.MediaTypeVideo,
+			Formats: []format.Format{&format.H264{
+				PayloadTyp:        96,
+				PacketizationMode: 1,
+			}},
+		}},
+	}
+
+	err := c.StartRecording("rtsp://127.0.0.1:8554/teststream", desc)
+	stopReader.Store(true)
+	<-readerDone
+	require.NoError(t, err)
+	c.Close()
+}
